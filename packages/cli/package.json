{
  "name": "@helixid/cli",
  "version": "0.1.1",
  "description": "Command-line interface for HelixID operator workflows — agent enrollment, bootstrap token management, wallet inspection, and credential lifecycle operations.",
  "type": "module",
  "bin": {
    "helix": "./dist/bin/helix.js"
  },
  "license": "Apache-2.0",
  "author": "DgVerse <hello@dgverse.in>",
  "homepage": "https://www.dgverse.in/products/helix-id",
  "repository": {
    "type": "git",
    "url": "https://github.com/dgverse-labs/helixid",
    "directory": "packages/cli"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "prepublishOnly": "pnpm build",
    "test": "vitest run --passWithNoTests",
    "test:non-live": "vitest run --passWithNoTests",
    "test:unit": "vitest run tests --passWithNoTests",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@helixid/core": "workspace:^",
    "@helixid/sdk-js": "workspace:^",
    "chalk": "^5.4.1",
    "commander": "^11.1.0"
  },
  "optionalDependencies": {
    "@helixid/did-hedera": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.8"
  }
}
