{
  "name": "@helix-id/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "test:non-live": "vitest run --passWithNoTests",
    "test:unit": "vitest run tests --passWithNoTests",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@helix-id/core": "workspace:*",
    "@helix-id/sdk-js": "workspace:*"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "*"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.8"
  }
}
