{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "helix-core/src/**/*.ts",
    "helix-api/src/**/*.ts",
    "helix-api/tests/**/*.ts",
    "helix-sdk-js/src/**/*.ts",
    "helix-sdk-js/tests/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/tests/**/*.ts",
    "packages/cli/src/**/*.ts",
    "packages/cli/tests/**/*.ts"
  ],
  "exclude": ["node_modules", "**/dist"]
}
