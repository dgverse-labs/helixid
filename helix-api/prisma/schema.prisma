// Prisma v7 schema
// See constitution §11 for core table list.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model VpId {
  id            String   @id @default(cuid())
  vpId          String   @unique
  agentDid      String
  userDid       String
  targetService String
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([vpId])
  @@map("vp_ids")
}

model EnrollmentToken {
  id               String      @id @default(cuid())
  tokenHash        String      @unique
  agentName        String
  requestedScopes  String
  requestedDomains String
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime    @default(now())
  challenges       Challenge[]

  @@map("enrollment_tokens")
}

model Challenge {
  id                  String           @id @default(cuid())
  challengeId         String           @unique
  nonce               String
  did                 String
  purpose             String
  pendingPublicKeyHex String?
  pendingDomains      String?
  expiresAt           DateTime
  verifiedAt          DateTime?
  createdAt           DateTime         @default(now())
  enrollmentToken     EnrollmentToken? @relation(fields: [enrollmentTokenId], references: [id])
  enrollmentTokenId   String?

  @@map("challenges")
}

model ServiceRegistry {
  id                 String   @id @default(cuid())
  serviceName        String   @unique
  displayName        String
  verifiedDomain     String
  publicKeyMultibase String
  apiEndpoint        String
  metadata           String
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("service_registry")
}
model Vc {
  id              String    @id @default(cuid())
  vcId            String    @unique
  subjectDid      String
  subjectType     String
  vcJson          String    @db.Text
  privilegeScopes String    @db.Text
  statusListIndex Int
  expiresAt       DateTime
  revokedAt       DateTime?
  renewedByVcId   String?
  createdAt       DateTime  @default(now())

  @@index([subjectDid])
  @@index([vcId])
  @@map("vcs")
}

model StatusListEntry {
  id          String   @id @default(cuid())
  listId      String   @unique
  encodedList String   @db.Text
  nextIndex   Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@map("status_list_entries")
}

model Did {
  id                   String      @id @default(cuid())
  did                  String      @unique
  // "agent" or "user"
  subjectType          String
  publicKeyHex         String
  publicKeyMultibase   String
  // Hedera HCS topic ID used for anchoring
  hederaTopicId        String      @default("")
  // Hedera sequence number of the anchoring message
  hederaSequenceNumber Int         @default(0)
  // The transaction consensus timestamp from Hedera (ISO 8601)
  hederaTransactionId  String
  // The full DID document JSON — stored for fast resolution
  didDocumentJson      String      @db.Text
  // Soft-delete marker — DID is never hard-deleted
  deactivated          Boolean     @default(false)
  deactivatedAt        DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  didUpdates           DidUpdate[]

  @@index([did])
  @@map("dids")
}

model DidUpdate {
  id                  String   @id @default(cuid())
  didId               String
  did                 Did      @relation(fields: [didId], references: [id])
  // "add_service_endpoint" | "remove_service_endpoint" | "deactivate"
  updateType          String
  // JSON snapshot of what changed
  updatePayloadJson   String
  hederaTransactionId String
  createdAt           DateTime @default(now())

  @@map("did_updates")
}

model AuditLog {
  id          String   @id @default(cuid())
  timestamp   String
  eventType   String
  requestId   String
  payloadJson String   @db.Text
  createdAt   DateTime @default(now())

  @@index([eventType])
  @@index([requestId])
  @@map("audit_log")
}
