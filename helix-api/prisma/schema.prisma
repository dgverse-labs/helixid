// Prisma v7 schema
// See constitution §11 for core table list.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Did {
  id                   String      @id
  subjectType          String
  controller           String
  publicKey            String
  publicKeyMultibase   String?
  hederaTopicId        String      @default("")
  hederaSequenceNumber Int         @default(0)
  hederaTransactionId  String
  didDocument          Json
  deactivatedAt        DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  updates              DidUpdate[]
  vcs                  Vc[]

  @@index([id])
  @@index([publicKey])
  @@map("dids")
}

model DidUpdate {
  id                  String   @id @default(cuid())
  didId               String
  updateType          String
  hederaTransactionId String
  payload             Json
  createdAt           DateTime @default(now())
  did                 Did      @relation(fields: [didId], references: [id])

  @@map("did_updates")
}

model Vc {
  id               String    @id @default(cuid())
  vcId             String    @unique
  subjectDid       String
  subjectType      String
  vcJson           Json
  privilegeScopes  Json?
  statusListIndex  Int
  expiresAt        DateTime
  revokedAt        DateTime?
  renewedByVcId    String?
  delegatedFrom    String?
  delegationDepth  Int?
  maxDelegationDepth Int?
  parentVcId       String?
  createdAt        DateTime  @default(now())
  did              Did       @relation(fields: [subjectDid], references: [id])

  @@index([subjectDid])
  @@index([vcId])
  @@index([parentVcId])
  @@map("vcs")
}

model StatusListEntry {
  id          String   @id @default(cuid())
  listId      String   @unique
  encodedList String
  nextIndex   Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@map("status_list_entries")
}

model VpId {
  id            String   @id @default(cuid())
  vpId          String   @unique
  agentDid      String
  userDid       String
  targetService String
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([vpId])
  @@map("vp_ids")
}

model EnrollmentToken {
  id               String      @id @default(cuid())
  tokenHash        String      @unique
  agentName        String
  requestedScopes  String
  requestedDomains String
  maxDelegationDepth Int         @default(0)
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime    @default(now())
  challenges       Challenge[]

  @@map("enrollment_tokens")
}

model Challenge {
  id                  String           @id @default(cuid())
  challengeId         String           @unique
  nonce               String
  did                 String
  purpose             String
  pendingPublicKeyHex String?
  pendingDomains      String?
  pendingDidCreateStateJson String?
  pendingDidCreatePayloadHex String?
  expiresAt           DateTime
  verifiedAt          DateTime?
  createdAt           DateTime         @default(now())
  enrollmentToken     EnrollmentToken? @relation(fields: [enrollmentTokenId], references: [id])
  enrollmentTokenId   String?

  @@map("challenges")
}

model ServiceRegistry {
  id                 String   @id @default(cuid())
  serviceName        String   @unique
  displayName        String
  verifiedDomain     String
  publicKeyMultibase String
  apiEndpoint        String
  metadata           String
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("service_registry")
}

model AuditLog {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now())
  eventType   String
  requestId   String
  payloadJson String
  createdAt   DateTime @default(now())

  @@index([eventType])
  @@index([requestId])
  @@map("audit_log")
}
