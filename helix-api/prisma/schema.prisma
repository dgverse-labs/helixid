// Prisma v7 schema
// See constitution §11 for core table list.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Did {
  id                   String      @id
  subjectType          String
  controller           String
  publicKey            String
  publicKeyMultibase   String?
  hederaTopicId        String      @default("")
  hederaSequenceNumber Int         @default(0)
  hederaTransactionId  String
  didDocument          Json
  deactivatedAt        DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  updates              DidUpdate[]
  vcs                  Vc[]

  @@index([id])
  @@index([publicKey])
  @@map("dids")
}

model DidUpdate {
  id                  String   @id @default(cuid())
  didId               String
  updateType          String
  hederaTransactionId String
  payload             Json
  createdAt           DateTime @default(now())
  did                 Did      @relation(fields: [didId], references: [id])

  @@map("did_updates")
}

model Vc {
  id               String    @id @default(cuid())
  vcId             String    @unique
  subjectDid       String
  subjectType      String
  vcJson           Json
  privilegeScopes  Json?
  statusListIndex  Int
  expiresAt        DateTime
  revokedAt        DateTime?
  renewedByVcId    String?
  delegatedFrom    String?
  delegationDepth  Int?
  maxDelegationDepth Int?
  parentVcId       String?
  createdAt        DateTime  @default(now())
  did              Did       @relation(fields: [subjectDid], references: [id])

  @@index([subjectDid])
  @@index([vcId])
  @@index([parentVcId])
  @@map("vcs")
}

model StatusListEntry {
  id          String   @id @default(cuid())
  listId      String   @unique
  encodedList String
  nextIndex   Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@map("status_list_entries")
}

model VpId {
  id            String   @id @default(cuid())
  vpId          String   @unique
  agentDid      String
  userDid       String
  targetService String
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([vpId])
  @@map("vp_ids")
}

model EnrollmentToken {
  id               String      @id @default(cuid())
  tokenHash        String      @unique
  agentName        String
  requestedScopes  String
  requestedDomains String
  maxDelegationDepth Int         @default(0)
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime    @default(now())
  challenges       Challenge[]

  @@map("enrollment_tokens")
}

model Challenge {
  id                  String           @id @default(cuid())
  challengeId         String           @unique
  nonce               String
  did                 String
  purpose             String
  pendingPublicKeyHex String?
  pendingDomains      String?
  pendingDidCreateStateJson String?
  pendingDidCreatePayloadHex String?
  expiresAt           DateTime
  verifiedAt          DateTime?
  createdAt           DateTime         @default(now())
  enrollmentToken     EnrollmentToken? @relation(fields: [enrollmentTokenId], references: [id])
  enrollmentTokenId   String?

  @@map("challenges")
}

model PreparedPayload {
  id                String    @id @default(cuid())
  token             String    @unique
  // 'delegation' | 'grant' — see docs/proposal-sdk-api-only.md. One purpose
  // per row; the finalize endpoint for a given purpose rejects tokens
  // prepared for a different one (PreparedPayloadPurposeMismatchError).
  purpose           String
  // Canonical JSON of the unsigned VC skeleton (no `proof` field). This is
  // exactly what hashCanonicalPayload() was run over to produce canonicalHash.
  unsignedPayload    String
  canonicalHash      String
  // DID whose signature finalize() must accept over canonicalHash. Prevents
  // a captured prepare response from being finalized with a different key.
  expectedSignerDid  String
  expiresAt          DateTime
  consumedAt         DateTime?
  createdAt          DateTime  @default(now())

  @@map("prepared_payloads")
}

model ServiceRegistry {
  id                 String   @id @default(cuid())
  serviceName        String   @unique
  displayName        String
  verifiedDomain     String
  publicKeyMultibase String
  apiEndpoint        String
  metadata           String
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("service_registry")
}

model AuditLog {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now())
  eventType   String
  requestId   String
  payloadJson String
  createdAt   DateTime @default(now())

  @@index([eventType])
  @@index([requestId])
  @@map("audit_log")
}

// ── Hosted accounts & auth (Item #1) ────────────────────────────────────────
// See docs/proposal-hosted-instance.md ("Decided: accounts, login, and
// DID/key custody"). Self-hosted deployments never populate these tables —
// a single operator authenticates with HELIX_ADMIN_API_KEY instead.

model Account {
  id           String    @id @default(cuid())
  email        String    @unique
  // Null when the account was created via Google sign-in only.
  passwordHash String?
  // Null until the account links (or is created via) Google sign-in.
  googleId     String?   @unique
  issuerDid    String?   @unique
  // Google accounts are verified by construction (emailVerified check at
  // link/create time); password accounts must click the emailed link.
  emailVerifiedAt            DateTime?
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  issuerKey     IssuerKeyRecord?
  refreshTokens RefreshToken[]

  @@map("accounts")
}

model IssuerKeyRecord {
  id                  String   @id @default(cuid())
  accountId           String   @unique
  did                 String   @unique
  // AES-256-GCM ciphertext of the raw Ed25519 private key, hex-encoded.
  // Encrypted/decrypted only through KeyCustody (encrypt/decrypt/sign),
  // never handled directly at call sites — see proposal-hosted-instance.md
  // ("Private key storage (interim, pre-KMS)").
  encryptedPrivateKey String
  iv                  String
  authTag             String
  algorithm           String   @default("aes-256-gcm")
  createdAt           DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@map("issuer_key_records")
}

model RefreshToken {
  id                String    @id @default(cuid())
  accountId         String
  // sha256 hex of the opaque bearer token — mirrors the hashToken() pattern
  // already used for enrollment tokens in agent.service.ts. The raw token
  // is returned to the client once and never stored.
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  // Points at the token this one was rotated into, forming a chain used for
  // reuse detection: presenting an already-revoked token is treated as a
  // compromise signal (see AuthService.refresh()).
  replacedByTokenId String?
  createdAt         DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@map("refresh_tokens")
}
