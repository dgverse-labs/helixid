{
  "name": "@helix-id/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run --exclude 'tests/live/**' --coverage --passWithNoTests",
    "test:all": "vitest run --passWithNoTests",
    "test:non-live": "vitest run --exclude 'tests/live/**' --passWithNoTests",
    "test:live": "vitest run tests/live --reporter=verbose",
    "test:unit": "vitest run tests/unit --passWithNoTests",
    "test:coverage": "vitest run --exclude 'tests/live/**' --coverage --passWithNoTests",
    "test:watch": "vitest",
    "test:security": "vitest run tests/security",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@fastify/sensible": "^6.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@hashgraph/sdk": "^2.49.0",
    "@helix-id/core": "workspace:*",
    "@hiero-did-sdk/registrar": "^0.1.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.7.0",
    "bs58": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.7.2",
    "pg": "^8.20.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@noble/ed25519": "^2.3.0",
    "@prisma/config": "^7.8.0",
    "@types/bs58": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^8.57.0",
    "prisma": "^7.7.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  }
}
