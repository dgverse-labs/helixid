# Local development only (`npm run dev`). Copy to console/.env.
# In containers these come from the runtime environment instead — see
# docker/40-env-config.sh and dev spec §6.
VITE_API_BASE_URL=http://localhost:4000
VITE_ADMIN_API_KEY=change-me

# Console login gate (client-side access gate only; defaults to admin/admin).
VITE_CONSOLE_USERNAME=admin
VITE_CONSOLE_PASSWORD=admin
