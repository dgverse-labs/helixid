{
  "name": "@helixid/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "prisma/schema.prisma"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test:deps": "true",
    "test": "pnpm run test:deps && vitest run --exclude 'tests/live/**' --coverage --passWithNoTests && node scripts/check-coverage-thresholds.mjs coverage/coverage-final.json 90 90 85 90 0 0 0 0",
    "test:all": "pnpm run test:deps && vitest run --passWithNoTests",
    "test:non-live": "pnpm run test:deps && vitest run --exclude 'tests/live/**' --passWithNoTests",
    "test:live": "pnpm run test:deps && vitest run tests/live --reporter=verbose --reporter=github-actions",
    "test:unit": "vitest run tests/unit --passWithNoTests",
    "test:coverage": "pnpm run test:deps && vitest run --exclude 'tests/live/**' --coverage --passWithNoTests && node scripts/check-coverage-thresholds.mjs coverage/coverage-final.json 90 90 85 90 0 0 0 0",
    "test:watch": "vitest",
    "test:security": "pnpm run test:deps && vitest run tests/security",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:test:prepare": "node scripts/prepare-test-db.mjs",
    "db:generate": "prisma generate",
    "db:reset": "prisma migrate reset --force",
    "test:e2e": "pnpm --filter @helixid/e2e run test",
    "workspace:build": "pnpm run build && pnpm -r --if-present run build",
    "workspace:typecheck": "pnpm run typecheck && pnpm -r --if-present run typecheck",
    "workspace:test": "pnpm run test && pnpm -r --if-present run test",
    "workspace:test:non-live": "pnpm run test:non-live && pnpm -r --if-present run test:non-live",
    "format": "prettier --write \"**/*.{ts,json,md}\" --ignore-path .gitignore",
    "generate:golden-vectors": "tsx scripts/generate-golden-vectors.ts",
    "setup": "tsx scripts/setup.ts",
    "setup:hedera": "tsx scripts/setup-hedera.ts"
  },
  "dependencies": {
    "@fastify/sensible": "^6.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@helixid/did-hedera": "github:helixid/helix-sdk-js#path:did-hedera",
    "@noble/curves": "^1.4.0",
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^1.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.7.0",
    "@prisma/config": "^7.8.0",
    "better-sqlite3": "^12.11.1",
    "bs58": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.7.2",
    "ioredis": "^5.11.0",
    "pg": "^8.20.0",
    "zod": "^3.23.0"
  },
  "packageManager": "pnpm@9.15.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.2",
      "protobufjs": "8.0.2",
      "@helixid/mcp-middleware>@helixid/sdk-js": "file:../helix-sdk-js/helix-sdk-js"
    }
  },
  "devDependencies": {
    "@helixid/sdk-js": "github:helixid/helix-sdk-js#path:helix-sdk-js",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bs58": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "prisma": "^7.7.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.8"
  }
}
