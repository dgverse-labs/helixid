{
  "name": "helix-id",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:all": "pnpm test && pnpm test:live",
    "test:non-live": "turbo run test:non-live",
    "test:live": "pnpm --filter @helix-id/api test:live",
    "test:unit": "pnpm --filter @helix-id/core test:unit && pnpm --filter @helix-id/sdk-js test:unit && pnpm --filter @helix-id/api test:unit && pnpm --filter @helix-id/mcp test:unit && pnpm --filter @helix-id/langchain test:unit",
    "test:coverage": "pnpm --filter @helix-id/core test:coverage && pnpm --filter @helix-id/sdk-js test:coverage && pnpm --filter @helix-id/api test:coverage",
    "test:e2e": "turbo run test --filter=@helix-id/e2e",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,json,md}\" --ignore-path .gitignore",
    "setup": "pnpm --filter @helix-id/api exec tsx ../scripts/setup.ts",
    "setup:hedera": "pnpm --filter @helix-id/api exec tsx ../scripts/setup-hedera.ts",
    "example:verify-vp": "pnpm --filter @helix-id/api exec tsx ../examples/verify-vp.ts",
    "example:scope-check": "pnpm --filter @helix-id/api exec tsx ../examples/scope-check.ts",
    "example:self-verify": "pnpm --filter @helix-id/api exec tsx ../examples/self-verify.ts",
    "example:revocation-check": "pnpm --filter @helix-id/api exec tsx ../examples/revocation-check.ts",
    "example:middleware:setup": "pnpm --filter @helix-id/example-framework-middleware run setup",
    "example:middleware:langchain": "pnpm --filter @helix-id/example-framework-middleware run langchain",
    "example:middleware:mcp": "pnpm --filter @helix-id/example-framework-middleware run mcp",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@helix-id/api"
  },
  "packageManager": "pnpm@9.15.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "prisma": {
    "schema": "helix-api/prisma/schema.prisma"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.2",
      "protobufjs": "8.0.2"
    }
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "turbo": "^2.3.0",
    "typescript": "^6.0.3",
    "vite": "^7.0.0"
  }
}
