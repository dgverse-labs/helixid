# Choose one: gemini, openai, anthropic
LLM_PROVIDER=gemini

# Optional. With no key, the demo uses its deterministic scripted planner.
# When set, this is read only by the agent backend and is never sent to the
# browser or an SP.
LLM_API_KEY=

# Optional. Leave blank to use the demo default for the selected provider.
# Examples: gemini-flash-latest, gpt-4o-mini, claude-sonnet-4-5
LLM_MODEL=gemini-flash-latest

HELIX_ADMIN_API_KEY=dev-admin-key-change-in-production
WALLET_PASSPHRASE=demo-passphrase
