# Escape hatch for hacking on helix-core / helix-sdk-js / @helixid/widget while
# the demo runs. Copy to docker-compose.override.yml (gitignored) and edit.
#
# The demo already depends on the workspace packages via `workspace:*`, so a
# rebuild picks up local changes. This override only saves you the rebuild by
# bind-mounting the built output straight into the containers.
#
#   cp docker-compose.override.yml.example docker-compose.override.yml
#   pnpm --filter @helixid/core --filter @helixid/sdk-js --filter @helixid/widget build
#   docker compose up

services:
  sp-airline:
    volumes:
      - ../../helix-core/dist:/app/helix-core/dist:ro
      - ../../helix-sdk-js/dist:/app/helix-sdk-js/dist:ro
      - ../../packages/widget/dist:/app/packages/widget/dist:ro

  sp-hotel:
    volumes:
      - ../../helix-core/dist:/app/helix-core/dist:ro
      - ../../helix-sdk-js/dist:/app/helix-sdk-js/dist:ro
      - ../../packages/widget/dist:/app/packages/widget/dist:ro

  agent:
    volumes:
      - ../../helix-core/dist:/app/helix-core/dist:ro
      - ../../helix-sdk-js/dist:/app/helix-sdk-js/dist:ro
