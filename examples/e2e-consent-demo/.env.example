# cp .env.example .env
#
# No LLM key is needed: this demo's agent is a deterministic HTTP driver, not a
# chat loop. (The conversational shell lives in examples/e2e-travel-concierge.)

HELIX_ADMIN_API_KEY=dev-admin-key-change-in-production
WALLET_PASSPHRASE=demo-passphrase

# Host the SP did:web identities are minted against. Must be reachable at this
# name from wherever verification happens — `localhost` works for the browser
# and for host-side tests.
DEMO_HOST=localhost
