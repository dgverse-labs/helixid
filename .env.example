# ─── DID Method ───────────────────────────────────────────────────────────────
# DID method for issuer operations. Allowed values: web, key. Support for hedera will be added in future releases.
DID_METHOD=web

# Domain this API is served from for did:web hosting
DID_DOMAIN=localhost:3000

# ─── Storage ──────────────────────────────────────────────────────────────────
# Storage adapter. Right now only sqlite is supported. postgres is planned for future releases.
HELIX_STORAGE_ADAPTER=sqlite

# SQLite DB file path (used when HELIX_STORAGE_ADAPTER=sqlite). Default path is ./data/helixid.sqlite. Use this variable if you want to override.
HELIX_SQLITE_PATH=./data/helixid.sqlite

# ─── Helix ID Signing ─────────────────────────────────────────────────────────
# Private key used by Helix ID to sign VCs (hex-encoded Ed25519 private key)
# Generate with: node -e "const {generateKeyPair} = require('./helix-core'); console.log(generateKeyPair())"
HELIX_SIGNING_KEY=abc123...

# Issuer DID whose DID document contains the public key derived from HELIX_SIGNING_KEY.
# Optional for DID_METHOD=web; defaults to did:web:${DID_DOMAIN}.
# Required for DID_METHOD=hedera.
# HELIX_ISSUER_DID=did:web:localhost:3000

# Short-lived JWT sessions are signed with an API startup-ephemeral Ed25519 keypair.
# The public key is served at /v1/sessions/public-key. Restarting the API rotates it.

# Required: admin key for protected VC endpoints (/v1/vcs issue/revoke/renew)
# Use at least 32 random chars in real environments.
# Example generator: openssl rand -hex 32
HELIX_ADMIN_API_KEY=replace-with-at-least-32-random-chars

# ─── API ──────────────────────────────────────────────────────────────────────
PORT=3000
API_BASE_URL=http://localhost:3000

# ─── Token / TTL Settings ─────────────────────────────────────────────────────
# Enrollment token validity window in seconds (default: 900 = 15 minutes)
ENROLLMENT_TOKEN_TTL_SECONDS=900

# Challenge nonce validity window in seconds (default: 300 = 5 minutes)
CHALLENGE_TTL_SECONDS=300

# VP expiry in seconds from time of template generation (default: 300 = 5 minutes)
VP_TTL_SECONDS=300

# JWT session validity window in seconds (default: 600 = 10 minutes)
JWT_SESSION_TTL_SECONDS=600

# ─── Cache ────────────────────────────────────────────────────────────────────
# Cache adapter. L1 in-process memory cache is enabled by default.
# Redis/L2 cache will be added for future releases.
HELIX_CACHE_ADAPTER=memory

# Optional cache toggle. Leave enabled unless you explicitly want to disable caching.
CACHE_ENABLED=true

# L1 cache TTLs (seconds). These are the only cache TTLs that currently matter.
DID_CACHE_L1_TTL_SECONDS=300
STATUS_LIST_CACHE_L1_TTL_SECONDS=60

# ─── Audit Log ────────────────────────────────────────────────────────────────
# Where to write audit events. Allowed values: stdout, file, both
AUDIT_LOG_DESTINATION=stdout

# Required only when AUDIT_LOG_DESTINATION is file or both
AUDIT_LOG_PATH=./logs/audit.log

# ─── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── E2E / Testing only ───────────────────────────────────────────────────────
# Set to true to allow E2E tests to write to Hedera testnet
# Never true in standard CI pipelines
HEDERA_E2E_TESTNET=false
